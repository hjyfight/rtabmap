{
  "widgets": [
    {
      "i": "rtabmap-fourmodal",
      "type": "fourmodal-features",
      "title": "四模态 · 特征融合",
      "x": 0,
      "y": 0,
      "w": 12,
      "h": 18,
      "props": {
        "topic": "/miti/fourmodal_features"
      }
    },
    {
      "i": "rtabmap-color",
      "type": "camera-viewer",
      "title": "RealSense · 彩色画面",
      "x": 0,
      "y": 18,
      "w": 2,
      "h": 8,
      "props": {
        "topic": "/camera/color/image_raw",
        "maxFps": 15
      }
    },
    {
      "i": "rtabmap-infrared",
      "type": "camera-viewer",
      "title": "RealSense · 右近红外",
      "rtabmapInfraredSourceVersion": 2,
      "x": 2,
      "y": 18,
      "w": 2,
      "h": 8,
      "props": {
        "topic": "/camera/infra2/image_rect_raw",
        "maxFps": 10,
        "colorMode": "gradient",
        "gradient": [
          "#000000",
          "#ffffff"
        ],
        "valueMin": 0,
        "valueMax": 255
      }
    },
    {
      "i": "fourmodal-lidar-input",
      "type": "urdf-viewer",
      "title": "LiDAR · 原始输入点云",
      "rtabmapWallsVersion": 1,
      "rtabmapPoseDisplayVersion": 1,
      "rtabmapGridLayoutVersion": 1,
      "rtabmapGraphFeatureLayoutVersion": 1,
      "rtabmapArcCameraLayoutVersion": 1,
      "rtabmapFourmodalLayoutVersion": 1,
      "x": 4,
      "y": 18,
      "w": 2,
      "h": 8,
      "props": {
        "version": 2,
        "frame": {
          "fixedFrame": "livox_frame",
          "displayFrame": "livox_frame",
          "followMode": "fixed",
          "syncTimestamps": false
        },
        "scene": {
          "background": "#111923",
          "renderStats": false,
          "labelScale": 6,
          "heightClip": {
            "enabled": false,
            "height": 2.0
          }
        },
        "view": {
          "distance": 12,
          "thetaOffset": 45,
          "phi": 55,
          "targetOffset": [
            0,
            0,
            0
          ]
        },
        "transforms": {
          "visible": false,
          "tfTopics": [],
          "staticTfTopics": []
        },
        "topics": {
          "/livox/lidar": {
            "visible": true,
            "type": "pointcloud",
            "pointSize": 2,
            "maxPoints": 100000,
            "maxRate": 5,
            "staleAfter": 3,
            "colorMode": "colormap",
            "colorField": "z"
          }
        },
        "layers": []
      }
    },
    {
      "i": "rtabmap-audio-spectrum",
      "type": "camera-viewer",
      "title": "声学 · log-Mel 声谱",
      "x": 6,
      "y": 18,
      "w": 2,
      "h": 8,
      "props": {
        "topic": "/miti/audio_spectrum/image_raw",
        "maxFps": 2
      }
    },
    {
      "i": "rtabmap-depth",
      "type": "camera-viewer",
      "title": "辅助深度 · 不参与四路融合",
      "rtabmapAlignedDepthVersion": 1,
      "rtabmapInfraredLayoutVersion": 1,
      "x": 8,
      "y": 18,
      "w": 2,
      "h": 8,
      "props": {
        "topic": "/miti/aligned_depth/image_raw",
        "maxFps": 10,
        "colorMode": "colormap",
        "valueMin": 300,
        "valueMax": 4000
      }
    }
  ],
  "mosaic": {
    "direction": "column",
    "first": "rtabmap-fourmodal",
    "second": {
      "direction": "row",
      "first": "rtabmap-color",
      "second": {
        "direction": "row",
        "first": "rtabmap-infrared",
        "second": {
          "direction": "row",
          "first": "fourmodal-lidar-input",
          "second": {
            "direction": "row",
            "first": "rtabmap-audio-spectrum",
            "second": "rtabmap-depth",
            "splitPercentage": 50
          },
          "splitPercentage": 33.33
        },
        "splitPercentage": 25
      },
      "splitPercentage": 20
    },
    "splitPercentage": 72
  }
}
