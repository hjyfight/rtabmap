{
  "widgets": [
    {
      "i": "rtabmap-scene", "type": "urdf-viewer", "title": "三维地图 · 轨迹 · 语义标签",
      "x": 0, "y": 0, "w": 8, "h": 20,
      "props": {
        "version": 2,
        "frame": {"fixedFrame": "map", "displayFrame": "map", "followMode": "fixed", "syncTimestamps": false},
        "scene": {"background": "#111923", "renderStats": false, "labelScale": 6},
        "view": {"distance": 12, "thetaOffset": 45, "phi": 55, "targetOffset": [0, 0, 0]},
        "transforms": {"visible": false, "tfTopics": ["/tf", "/tf_static"], "staticTfTopics": ["/tf_static"]},
        "topics": {
          "/cloud_map": {"visible": true, "type": "pointcloud", "pointSize": 2, "maxPoints": 300000, "colorMode": "colormap", "colorField": "z", "maxRate": 5, "staleAfter": 30},
          "/livox/lidar": {"visible": false, "type": "pointcloud", "pointSize": 2, "maxPoints": 100000, "maxRate": 10},
          "/miti/trajectory": {"visible": true, "type": "path", "poseType": "line", "lineWidth": 0.035},
          "/miti/semantic_markers": {"visible": true, "type": "markers"},
          "/icp_odom": {"visible": true, "type": "odometry", "axisScale": 0.4}
        },
        "layers": []
      }
    },
    {
      "i": "rtabmap-color", "type": "camera-viewer", "title": "RealSense · 彩色画面",
      "x": 8, "y": 0, "w": 4, "h": 8,
      "props": {"topic": "/camera/color/image_raw", "maxFps": 15}
    },
    {
      "i": "rtabmap-depth", "type": "camera-viewer", "title": "RealSense · 对齐深度",
      "x": 8, "y": 8, "w": 4, "h": 8,
      "props": {"topic": "/camera/aligned_depth_to_color/image_raw", "maxFps": 10, "colorMode": "colormap", "valueMin": 300, "valueMax": 4000}
    },
    {
      "i": "rtabmap-log", "type": "log", "title": "运行日志 · 回环与异常",
      "x": 8, "y": 16, "w": 4, "h": 4,
      "props": {"topic": "/rosout", "minLevel": "INFO", "showTime": true, "showName": true}
    }
  ],
  "mosaic": {
    "direction": "row", "first": "rtabmap-scene", "splitPercentage": 68,
    "second": {"direction": "column", "first": "rtabmap-color", "splitPercentage": 38,
      "second": {"direction": "column", "first": "rtabmap-depth", "second": "rtabmap-log", "splitPercentage": 60}}
  }
}
