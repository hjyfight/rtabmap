        "instance_id": {
          "type": "integer",
          "minimum": 0
        },
        "position": {
          "type": "object",
          "properties": {
            "frame_id": {
              "type": "string",
              "minLength": 1
            },
            "xyz_m": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                {
                  "type": "null"
                }
              ]
            },
            "extent_m": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                {
                  "type": "null"
                }
              ]
            },
            "valid": {
              "type": "boolean"
            }
          },
          "required": [
            "frame_id",
            "xyz_m",
            "extent_m",
            "valid"
          ],
          "additionalProperties": true
        },
        "motion": {
          "type": "object",
          "properties": {
            "target_id": {
              "type": "string",
              "minLength": 1
            },
            "frame_id": {
              "type": "string",
              "minLength": 1
            },
            "motion_valid": {
              "type": "boolean"
            },
            "velocity_m_s": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                {
                  "type": "null"
                }
              ]
            },
            "speed_m_s": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "predicted_position_1s": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "target_id",
            "frame_id",
            "motion_valid",
            "velocity_m_s",
            "speed_m_s",
            "predicted_position_1s"
          ],
          "additionalProperties": true
        },
        "modalities": {
          "type": "object",
          "properties": {
            "rgb": {
              "$ref": "#/$defs/association"
            },
            "infrared": {
              "$ref": "#/$defs/association"
            },
            "lidar": {
              "$ref": "#/$defs/association"
            },
            "audio": {
              "$ref": "#/$defs/association"
            }
          },
          "required": [
            "rgb",
            "infrared",
            "lidar",
            "audio"
          ],
          "additionalProperties": true
        },
        "features": {
          "type": "object",
          "properties": {
            "encoder": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 1024,
                "maxItems": 1024
              },
              "minItems": 4,
              "maxItems": 4
            },
            "independent": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 1024,
                "maxItems": 1024
              },
              "minItems": 4,
              "maxItems": 4
            },
            "joint": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 4096,
              "maxItems": 4096
            },
            "fused": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 1024,
              "maxItems": 1024
            },
            "valid_mask": {
              "type": "array",
              "items": {
                "type": "boolean"
              },
              "minItems": 4,
              "maxItems": 4
            },
            "weights": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "minItems": 4,
              "maxItems": 4
            },
            "complete": {
              "type": "boolean"
            },
            "fused_valid": {
              "type": "boolean"
            }
          },
          "required": [
            "encoder",
            "independent",
            "joint",
            "fused",
            "valid_mask",
            "weights",
            "complete",
            "fused_valid"
          ],
          "additionalProperties": true
        },
        "safety": {
          "$ref": "#/$defs/safety"
        },
        "quality": {
          "type": "object"
        },
        "preprocessing": {
          "type": "object"
        },
        "uncertainty": {
          "type": "object",
          "properties": {
            "accuracy_verified": {
              "type": "boolean"
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "missing_modalities": {
              "type": "array",
              "items": {
                "enum": [
                  "rgb",
                  "infrared",
                  "lidar",
                  "audio"
                ]
              }
            },
            "conflicts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "minLength": 1
                  },
                  "participating_modalities": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "rgb",
                        "infrared",
                        "lidar",
                        "audio"
                      ]
                    }
                  },
                  "handling": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "type",
                  "participating_modalities",
                  "handling"
                ],
                "additionalProperties": true
              }
            }
          },
          "required": [
            "accuracy_verified",
            "reasons",
            "missing_modalities",
            "conflicts"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "target_id",
        "label",
        "baseline_label",
        "instance_id",
        "position",
        "motion",
        "modalities",
        "features",
        "safety",
        "quality",
        "preprocessing",
        "uncertainty"
